# Copy to .env and fill in. NEVER commit .env to git.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://campuskit:CHANGE_ME@localhost:5432/campuskit

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
OTP_SECRET=

# Where the frontend runs (CORS). Comma-separated for several.
CORS_ORIGIN=http://localhost:5173

# Email (SMTP). In development, if SMTP_HOST is empty the OTP is printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampusKit <no-reply@example.com>"

# Photos are stored on local disk for now (see src/storage.js to swap later).
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000

# Product decisions (change freely)
NEW_USER_MAX_PRICE=500
NEW_USER_MAX_ACTIVE_LISTINGS=5

# Set to 1 when deployed behind ONE reverse proxy (most hosts), so rate limiting sees real IPs.
TRUST_PROXY=

# Odd semesters (1,3,5,7) start in this month (1-12). Check your college calendar.
ODD_SEMESTER_START_MONTH=7

# ---- Cloud settings (needed when deployed; leave empty on your own PC) ----
# Set to true for Supabase / Neon / any hosted database
DATABASE_SSL=
# Photo bucket (S3-compatible). If S3_BUCKET is empty, photos are kept on local disk.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public web address under which a photo key becomes viewable, with NO trailing slash
S3_PUBLIC_BASE_URL=
